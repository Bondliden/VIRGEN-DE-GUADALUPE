# ─────────────────────────────────────────────
# Santa María de Guadalupe 500 Años — Environment
# Copy this file to .env and fill in the values.
# Every VITE_* variable IS EXPOSED to the browser bundle.
# Variables without the VITE_ prefix stay server-side only.
# ─────────────────────────────────────────────

# Public site URL (used for canonical + Open Graph tags)
VITE_SITE_URL=https://santamariadeguadalupe500years.com

# Where pilgrimage registrations and shop notices are delivered.
# Leave empty to fall back to WhatsApp + email only.
# Accepts any endpoint that receives a JSON POST (Make, Zapier, n8n, Formspree, etc.)
VITE_LEADS_ENDPOINT=

# Clave de web3forms.com: cada alta (peregrinar, capitán, documental, aviso
# de la tienda) llega como un correo al buzón con el que se pidió la clave.
# Tiene prioridad sobre VITE_LEADS_ENDPOINT. Es pública por diseño.
VITE_WEB3FORMS_KEY=

# ─────────────────────────────────────────────
# Direct WhatsApp button
# International format, digits only, no + and no spaces.
#   Mexico City:   525512345678
#   United States: 17864930789
# Leave empty and the button stays hidden.
# ─────────────────────────────────────────────
VITE_WHATSAPP_NUMBER=
VITE_WHATSAPP_MESSAGE=Hola, quiero información sobre las peregrinaciones a la Basílica de Guadalupe.

# Calendly de Azucena para reservar una videollamada (botón redondo sobre
# el de WhatsApp). Vacío: el botón no se muestra.
VITE_CALENDLY_URL=

# Contact details shown across the site
VITE_CONTACT_EMAIL=info@santamariadeguadalupe500years.com
VITE_INSTAGRAM_HANDLE=
VITE_YOUTUBE_HANDLE=@inbguadalupe3618

# Non-profit / donation details (shown in the disclosure)
VITE_NONPROFIT_NAME=
VITE_NONPROFIT_URL=
VITE_DONATE_URL=

# ─────────────────────────────────────────────
# Chat assistant (Lupita): DeepSeek first, GLM if it fails
# The browser calls this same-origin path; the server adds the keys.
# Never put a key in a VITE_ variable. A provider with no key is skipped.
# ─────────────────────────────────────────────
VITE_CHAT_ENDPOINT=/api/chat

# 1) DeepSeek V4.1 Flash — the fast one, tried first. Server-side only.
#    Key at https://platform.deepseek.com/api_keys
#    deepseek-flash: $0.15 / $0.60 per 1M (cache hits $0.003-0.006: the
#    long system prompt is cached, so most input is almost free).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# 2) GLM — the fallback. Server-side only. Key at https://z.ai (or https://open.bigmodel.cn)
GLM_API_KEY=
# Model choice — see the note below before changing it.
#   glm-5.3-flash  $0.15 / $0.50 per 1M tokens  <- default, best value
#   glm-5.3-flashx $0.37 / $1.25
#   glm-4.5-air    $0.20 / $1.10
#   glm-5.3        $1.40 / $4.40  <- flagship, ~9x the cost
#   glm-4.7-flash / glm-4.5-flash  free, but NOT always enabled on an account
GLM_MODEL=glm-5.3-flash
# The glm-5.3 family ALWAYS reasons and you are billed for it at the OUTPUT
# rate. "low" keeps that near zero; the default is "max", which was burning
# ~74% of the output budget on thinking. Values: low | high | max
GLM_REASONING_EFFORT=low
GLM_BASE_URL=https://api.z.ai/api/paas/v4/chat/completions

